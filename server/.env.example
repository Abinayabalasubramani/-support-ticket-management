# Pooled connection string (used by the running app). Neon: host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# Direct connection string (used by Prisma migrations).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

PORT=4000
NODE_ENV=development
# Allowed browser origin(s), comma-separated.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login tokens: at least 32 random characters. Never commit the real one.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# How long a login lasts (e.g. 8h, 30m, 7d)
JWT_EXPIRES_IN=8h

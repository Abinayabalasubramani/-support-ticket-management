# Used only by `npm test`. Points at a SEPARATE Postgres schema ("test") so tests
# can wipe tables freely without touching real data. Use the DIRECT (non-pooler) URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&schema=test"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&schema=test"
PORT=4001
NODE_ENV=test
CORS_ORIGIN=http://localhost:5173

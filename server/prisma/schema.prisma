generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Non-status updates shown in a ticket's timeline (status changes live in StatusHistory).
enum ActivityType {
  ASSIGNEE_CHANGED
  TICKET_EDITED
}

enum Role {
  ADMIN
  AGENT
}

model User {
  id             Int                  @id @default(autoincrement())
  name           String
  email          String               @unique
  // bcrypt hash, never the password itself. Optional so a user without a password simply cannot log in.
  passwordHash   String?
  role           Role                 @default(AGENT)
  tickets        Ticket[]
  collaborations TicketCollaborator[]
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  tickets Ticket[]
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  description String
  priority    Priority @default(MEDIUM)
  status      Status   @default(OPEN)
  categoryId  Int
  assigneeId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Deleting a category that still has tickets is blocked.
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Deleting a user unassigns their tickets.
  assignee      User?                @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  history       StatusHistory[]
  activity      TicketActivity[]
  // Other team members working on the ticket besides the main assignee.
  collaborators TicketCollaborator[]

  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([assigneeId])
  @@index([createdAt])
}

// A ticket has one main assignee (Ticket.assigneeId) and any number of collaborators.
// The pair (ticket, user) is the key, so nobody can be added twice.
model TicketCollaborator {
  ticketId  Int
  userId    Int
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

model TicketActivity {
  id        Int          @id @default(autoincrement())
  ticketId  Int
  type      ActivityType
  // ASSIGNEE_CHANGED: { from: {id, name} | null, to: {id, name} | null }
  // TICKET_EDITED:    { changes: [{ field, from, to }] }
  // Names are stored as they were at the time, so the history stays readable if a user is renamed or deleted.
  details   Json
  createdAt DateTime     @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model StatusHistory {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  // null when the ticket is first created
  fromStatus Status?
  toStatus   Status
  changedAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, changedAt])
}
